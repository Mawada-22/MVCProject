@model IEnumerable<EmpDto>

@{
    ViewData["Title"] = "Employees";
}

<h1>All Employees</h1>

<div class="mb-3">
    <a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create New Employee</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-8">
        <input type="text" id="searchInp" name="Search" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-4">
        <input type="submit" value="Search" class="btn btn-success" />
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-striped table-hover text-center">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.First().Name)</th>
                <th>@Html.DisplayNameFor(m => m.First().EmpType)</th>
                <th>@Html.DisplayNameFor(m => m.First().Email)</th>
                <th>@Html.DisplayNameFor(m => m.First().Age)</th>
                <th>@Html.DisplayNameFor(m => m.First().Salary)</th>
                <th>@Html.DisplayNameFor(m => m.First().IsActive)</th>
                <th>@Html.DisplayNameFor(m => m.First().gender)</th>
                <th>@Html.DisplayNameFor(m => m.First().DepartmentName)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                        <img src="~/Files/Images/@(employee.Image ?? "Defalut.jpg")"
                             alt="@employee.Name"
                             class="rounded-circle shadow-sm"
                             style="width: 50px; height: 50px; object-fit: cover;" />
                    </td>
                    <td>@Html.DisplayFor(_ => employee.Name)</td>
                    <td>@Html.DisplayFor(_ => employee.EmpType)</td>
                    <td>@Html.DisplayFor(_ => employee.Email)</td>
                    <td>@Html.DisplayFor(_ => employee.Age)</td>
                    <td>@Html.DisplayFor(_ => employee.Salary)</td>
                    <td>@Html.DisplayFor(_ => employee.IsActive)</td>
                    <td>@Html.DisplayFor(_ => employee.gender)</td>
                    <td>@Html.DisplayFor(_ => employee.DepartmentName)</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@employee.ID" class="btn btn-info btn-sm">Details</a>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@employee.ID" class="btn btn-warning btn-sm">Update</a>
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@employee.ID">
                            Delete
                        </button>
                    </td>
                </tr>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal-@employee.ID" tabindex="-1" aria-labelledby="deleteLabel-@employee.ID" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteLabel-@employee.ID">Delete Employee</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete <strong>@employee.Name</strong>?
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-route-id="@employee.ID" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-4">
        <h4>No employees found.</h4>
    </div>
}
