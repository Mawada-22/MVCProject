@*first of all chose the model of needed data*@

@model IEnumerable<DepartmentToReturnDto>
@{
    ViewData["Title"] = "Index";
   
}
@*Master page of all departments*@
<h1>Departments</h1>
<br \>
<br \>

<a asp-controller="Department" asp-action="Create" class="btn btn-primary">Create Dapartment</a>
<br \ >
 @if (Model.Count()>0){

<table calss="mt-4 table table-striped table-hover">

    <thead class="text-center">
     <tr>
         <th>@Html.DisplayNameFor(D=>D.Code)</th>
         <th>@Html.DisplayNameFor(D=>D.Name)</th>
         <th>@Html.DisplayNameFor(D=>D.CreationDate)</th>
         <th>Detils</th>
         <th>update</th>
         <th>Delete</th>
     </tr> 
    </thead>

    <tbody class="text-center">
        @foreach(var dep in Model){
            <tr>
                <td>@dep.Code</td>
                <td>@dep.Name</td>
                <td>@dep.CreationDate</td>
                <td>
                        <a asp-controller="Department" asp-action="Details" asp-route-id="@dep.Id" class="btn btn-warning"> <i class="fa-solid fa-eye"></i> Details</a>
                </td>
                    <td>
                        <a asp-controller="Department" asp-action="Edit" asp-route-id="@dep.Id" class="btn btn-success"> <i class="fa-solid fa-edit"></i> Update</a>
                    </td>
                    <td>
                        <a asp-controller="Department" asp-action="Delete" asp-route-id="@dep.Id" class="btn btn-danger"> <i class="fa-solid fa-trash"></i> Delete</a>
                    </td>
            </tr>
     
        }

    </tbody>
</table>

 }
 else{

     <div class="mt-4 alert alert-info">There is no Department</div>
 }




