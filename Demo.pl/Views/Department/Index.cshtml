@model IEnumerable<DepartmentToReturnDto>

@{
    ViewData["Title"] = "Departments";
}

<h1 class="mb-4">Departments</h1>

<a asp-controller="Department" asp-action="Create" class="btn btn-primary mb-3">
    <i class="bi bi-plus-circle"></i> Create Department
</a>

@if (Model.Any())
{
    <table class="table table-striped table-hover text-center">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(d => d.Code)</th>
                <th>@Html.DisplayNameFor(d => d.Name)</th>
                <th>@Html.DisplayNameFor(d => d.CreationDate)</th>
                <th colspan="3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var dep in Model)
            {
                <tr>
                    <td>@dep.Code</td>
                    <td>@dep.Name</td>
                    <td>@dep.CreationDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@dep.Id" class="btn btn-info btn-sm">
                            <i class="bi bi-eye"></i> Details
                        </a>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@dep.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i> Edit
                        </a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-id="@dep.Id" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-4">There are no departments.</div>
}
