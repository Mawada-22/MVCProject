@model DepartmentDetailsDto
@{
    ViewData["Title"] = "DetailsDeletDepartmentPartial";
    bool isAdmin = User.IsInRole("Admin"); // Assuming roles are used
}


<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        <a class="navbar-brand" href="#">Department System</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link @(isAdmin ? "active" : "")" asp-controller="Department" asp-action="Index">Admin View</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(isAdmin ? "" : "active")" asp-controller="Department" asp-action="Index">Employee View</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <h1 class="mb-4">Department Details</h1>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                @if (isAdmin) // Admin sees all details
                {
                    <dt class="col-sm-3">ID:</dt>
                    <dd class="col-sm-9">@Model.Id</dd>

                    <dt class="col-sm-3">Created By:</dt>
                    <dd class="col-sm-9">@Model.CreatedBy</dd>

                    <dt class="col-sm-3">Created On:</dt>
                    <dd class="col-sm-9">@Model.CreatedOn.ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">Last Updated By:</dt>
                    <dd class="col-sm-9">@Model.LastUpdatedBy</dd>

                    <dt class="col-sm-3">Last Updated On:</dt>
                    <dd class="col-sm-9">@Model.LastUpdatedOn.ToString("yyyy-MM-dd HH:mm")</dd>
                }

                <dt class="col-sm-3">Name:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Code:</dt>
                <dd class="col-sm-9">@Model.Code</dd>

                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>
    </div>

    @if (ViewBag.Action == "Details")
    {
        <div class="mt-4">
            <a asp-controller="Department" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="fa-solid fa-edit"></i> Edit Department
            </a>

            <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Back to List
            </a>
        </div>
    }else{
        <div>
            <form asp-action="Delete" class="mt-4">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </form>
        </div>
    }

    
</div>
