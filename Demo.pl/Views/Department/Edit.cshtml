
@model DepartmetEditViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<div class="row justify-content-center align-items-center">
    <h1 class="col-8 my-4">Update Department</h1>

    <form asp-action="Edit" method="post" class="col-8">
        <input type="hidden" asp-for="Code" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group mb-3">
            <label class="col-form-label" asp-for="Code"></label>
            <input asp-for="Code" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label class="col-form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label class="col-form-label" asp-for="Description"></label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label class="col-form-label" asp-for="CreationDate"></label>
            <input asp-for="CreationDate" class="form-control" type="datetime-local"
                   value="@Model?.CreationDate.ToString("yyyy-MM-ddTHH:mm")" />
        </div>

        <div class="mt-4">
            <input type="submit" class="btn btn-primary" value="Save Changes" />
            <span>|</span>
            <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>

</div>
@section ValidationScript {
    <partial name="_ValidationScriptsPartial"></partial>
}